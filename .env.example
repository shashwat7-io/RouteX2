# RouteX AI 2.0 - Environment Configuration

# NASA Earthdata Login Credentials (for GES DISC / CMR GPM IMERG satellite precipitation access)
# Register for free at: https://urs.earthdata.nasa.gov/
EARTHDATA_USERNAME=your_earthdata_username
EARTHDATA_PASSWORD=your_earthdata_password

# OpenRouteService API Key (Optional - Fallback geometric corridor router active if omitted)
# Register at: https://openrouteservice.org/
ORS_API_KEY=your_ors_api_key_here

# Hugging Face API Key (Optional - For AI Landslide Emergency Chatbot Assistant)
# Register at: https://huggingface.co/settings/tokens
HF_API_KEY=your_huggingface_api_key_here

# Server Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=*
ENVIRONMENT=production
